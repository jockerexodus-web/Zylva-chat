# ============================================
# 📧 Configuration Resend (recommandé)
# ============================================
# 1. Va sur https://resend.com → Sign up
# 2. API Keys → Create API Key → copie
# 3. Domaines → Ajoute ton domaine (ou utilise onboarding@resend.dev pour tester)
# ============================================

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=Zylva Labs <noreply@zylvalabs.com>
# Pour tester sans domaine : onboarding@resend.dev

# Serveur
PORT=3000
NODE_ENV=production

# CORS (sépare par des virgules)
ALLOWED_ORIGINS=http://localhost:8080,https://zylva-labs.netlify.app,https://zylva-labs.vercel.app
